{
  "name": "hydrooj-remote-judge-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Remote AC verification plugin scaffold for HydroOJ",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "locales",
    "index.js",
    "frontend",
    "shared"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "hydrooj": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "hydrooj": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waylanguo-web/Hydro_RemoteJudgeSync.git"
  }
}
